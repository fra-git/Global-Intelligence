# Required
CLAUDE_CODE_OAUTH_TOKEN=     # from `claude setup-token` (Claude Pro/Max subscription)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=           # comma-separated: @channelname or numeric ids

# Optional
BRIEFING_MODEL=sonnet        # Claude Code model alias: sonnet | opus
BRIEFING_EFFORT=high         # low | medium | high | xhigh | max
BRIEFING_PARALLEL_DESKS=3    # research desks run side by side (1 = one at a time)
BRIEFING_SEARCH_SCALE=1      # multiplies every desk's web-search budget (0.5 saves plan usage)
BRIEFING_TIMEOUT_S=1500      # per Claude run
BRIEFING_STATE_DIR=state
BRIEFING_ARCHIVE_DIR=archive
# Never set ANTHROPIC_API_KEY: the pipeline strips it so runs stay on the subscription.
