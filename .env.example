# Required
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=          # comma-separated: @channelname or numeric ids

# Optional
BRIEFING_MODEL=claude-opus-5
BRIEFING_EFFORT=high         # low | medium | high | xhigh | max
BRIEFING_MAX_CHARS=3800
BRIEFING_WEB_SEARCH_MAX_USES=15
BRIEFING_STATE_DIR=state
BRIEFING_ARCHIVE_DIR=archive
